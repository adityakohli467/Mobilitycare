# faq → customer-service (duplicate eliminated)
# (redirect already handled above in rewrite rules)

# blog
RewriteCond %{THE_REQUEST} \s/index\.php\?route=extension/simple_blog/article[\s?] [NC]
RewriteRule ^index\.php$ /blog? [R=301,L]

# Blog individual articles: rewrite clean URL to OpenCart route
RewriteRule ^blog/([0-9]+)/?$ index.php?route=extension/simple_blog/article/view&simple_blog_article_id=$1 [L,QSA]

# Blog individual articles: redirect ugly URL to clean URL
RewriteCond %{THE_REQUEST} \s/index\.php\?route=extension/simple_blog/article/view&simple_blog_article_id=([0-9]+) [NC]
RewriteRule ^index\.php$ /blog/%1? [R=301,L]


RewriteCond %{THE_REQUEST} \s/index\.php\?route=product/category&path=101[\s?] [NC]
RewriteRule ^index\.php$ /featured-products? [R=301,L]

# Mobility Aids category (path=63) → SEO URL
RewriteCond %{QUERY_STRING} ^route=product/category&path=63$ [NC]
RewriteRule ^index\.php$ /shop/mobility-aids? [R=301,L]

RewriteCond %{THE_REQUEST} \s/index\.php\?route=product/manufacturer[\s?] [NC]
RewriteRule ^index\.php$ /brands? [R=301,L]










############################################################
# Prevent access to sensitive folders (now in root)
############################################################
RedirectMatch 403 ^/system/
RedirectMatch 403 ^/storage/
RedirectMatch 403 ^/config\.php$


