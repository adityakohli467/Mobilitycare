# General manufacturer listing redirect
# General manufacturer listing redirect (MUST be LAST)





# === NEW SEO-FRIENDLY STATIC PAGES ===
RewriteRule ^about-us/?$ index.php?route=information/aboutUs [L,QSA]
RewriteRule ^blog/?$ index.php?route=extension/simple_blog/article [L,QSA]
RewriteRule ^terms-conditions/?$ index.php?route=information/information&information_id=5 [L,QSA]
RewriteRule ^privacy-policy/?$ index.php?route=information/information&information_id=3 [L,QSA]
RewriteRule ^faq/?$ /customer-service [R=301,L]
RewriteRule ^delivery-information/?$ index.php?route=information/information&information_id=6 [L,QSA]
RewriteRule ^demo-videos/?$ index.php?route=information/information&information_id=7 [L,QSA]
RewriteRule ^featured-products/?$ index.php?route=product/category&path=101 [L,QSA]

# Document / PDF Viewer (SEO-friendly download URLs)
RewriteRule ^documents/([a-zA-Z0-9_-]+)-([0-9]+)/?$ index.php?route=product/product/viewDocument&download_id=$2 [L,QSA]

# Canonical redirect: old download URLs → SEO-friendly /documents/ URLs
# (handled by the controller — old URLs still work as raw PDF stream)

RewriteRule ^brands/?$ index.php?route=product/manufacturer&path=101 [L,QSA]


############################################################
# 301 Redirects: Old Category URLs → New URLs (SEO migration)
############################################################
