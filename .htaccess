# --- Pattern: Strip /1000 and //1000 from /buy/ URLs ---
RewriteRule ^buy/([^/]+)//1000$ /buy/$1 [R=301,L]
RewriteRule ^buy/([^/]+)/1000$ /buy/$1 [R=301,L]

# --- Pattern: Fix concatenated /buy/CATEGORY/buy/PRODUCT URLs ---
RewriteRule ^buy/[^/]+/buy/([^/]+)$ /buy/$1 [R=301,L]

# --- Pattern: Strip /1000 from other paths ---
RewriteRule ^(.+)//1000$ /$1 [R=301,L]
RewriteRule ^(.+)/1000$ /$1 [R=301,L]

# --- Pattern: Strip /feed/ suffix (WordPress RSS remnant) ---
RewriteRule ^(.+)/feed/?$ /$1 [R=301,L]

