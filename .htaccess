############################################################
# OpenCart .htaccess for ROOT (public_html)
############################################################
# PHP memory limit
php_value memory_limit 256M

# Custom error document for 410 Gone responses
ErrorDocument 410 "<!DOCTYPE html><html><head><title>410 Gone</title></head><body><h1>410 Gone</h1><p>This content has been permanently removed.</p></body></html>"

# Enable mod_rewrite
Options +FollowSymlinks
RewriteEngine On
RewriteBase /

############################################################
# Force www + HTTPS (canonical domain)
# Redirect non-www -> www and HTTP -> HTTPS in one hop
############################################################
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.mobilitycare.net.au/$1 [R=301,L]

############################################################
# Remove trailing slash (canonical: no trailing slash)
# IMPORTANT: Skip POST requests -- a 301 converts POST->GET, losing form data
############################################################
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

############################################################
# WordPress -> OpenCart Migration Redirects
# Generated from SEMRush + Google Search Console 404 data
# Total: 470 x 301 redirects, 15 x 410 gone
############################################################

