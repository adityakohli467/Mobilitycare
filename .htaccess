RewriteRule ^shop/mobility-aids/power-assist-wheelchair/?$ https://www.mobilitycare.net.au/shop/mobility-aids/wheelchairs/power-assist-wheelchairs [R=301,L]

RewriteCond %{REQUEST_URI} ^/shop/mobility-aids/toileting/?$ [NC]
RewriteRule ^.*$ /shop/toilet-aids? [R=301,L]

RewriteCond %{REQUEST_URI} ^/shop/mobility-aids/rollators-walkers-walking-aids/?$ [NC]
RewriteRule ^.*$ /shop/mobility-aids/walking-aids/rollators-walking-frames? [R=301,L]

