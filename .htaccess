############################################################
# OpenCart .htaccess for ROOT (public_html)
############################################################
# PHP memory limit
php_value memory_limit 256M

# Enable mod_rewrite
Options +FollowSymlinks
RewriteEngine On
RewriteBase /

############################################################
# Force www + HTTPS (canonical domain)
# Redirect non-www → www and HTTP → HTTPS in one hop
############################################################
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.mobilitycare.net.au/$1 [R=301,L]

############################################################
# Remove trailing slash (canonical: no trailing slash)
# IMPORTANT: Skip POST requests — a 301 converts POST→GET, losing form data
############################################################
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

############################################################
# Custom SEO Routes
############################################################

# Product Trial
RewriteRule ^organise-a-product-trial/?$ index.php?route=information/trial_request [L,QSA]
# Product Demonstration
RewriteRule ^organise-a-product-demonstration/?$ index.php?route=information/demo_request [L,QSA]
# Funding Support
RewriteRule ^am-i-eligible-for-funding-support/?$ /funding-support [R=301,L]

RewriteRule ^funding-support/?$ index.php?route=information/funding_support [L,QSA]
RewriteRule ^ndis/?$ index.php?route=information/ndis [L,QSA]
# Place Order
RewriteRule ^place-an-order/?$ index.php?route=information/place_order [L,QSA]
# Request Quote
RewriteRule ^request-quote/?$ index.php?route=information/quote_request [L,QSA]
# Warranty Claim
RewriteRule ^warranty-claim/?$ index.php?route=information/warranty_claim [L,QSA]
# Contact
RewriteRule ^contact-mobilitycare/?$ index.php?route=information/contact [L,QSA]
RewriteRule ^product_enq/?$ index.php?route=information/product_enq [L,QSA]
RewriteRule ^find-a-dealer/?$ index.php?route=dealer/findDealer [L,QSA]
RewriteRule ^become-a-dealer/?$ index.php?route=dealer/dealer [L,QSA]
RewriteRule ^customer-service/?$ index.php?route=information/support [L,QSA]
RewriteRule ^returns-warranty-policy/?$ index.php?route=information/information&information_id=8 [L,QSA]
RewriteRule ^light-drive-2-enquiry/?$ index.php?route=information/lightDriveEnquiry [L,QSA]
RewriteRule ^autochair-smart-lifter-enquiry/?$ index.php?route=information/autochairEnquiry [L,QSA]
RewriteRule ^request-local-dealer/?$ index.php?route=information/find_dealer_form [L,QSA]

RewriteRule ^home/?$ index.php?route=extension/mobile/home [L,QSA]

# Canonical redirect: mobile home URL
RewriteCond %{THE_REQUEST} \s/index\.php\?route=extension/mobile/home[\s&] [NC]
RewriteRule ^index\.php$ /home? [R=301,L,QSD]

############################################################
# Canonical Redirects: Force SEO URLs for Information Pages
############################################################
# Quote Request
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/quote_request[\s&] [NC]
RewriteRule ^index\.php$ /request-quote/? [R=301,L,QSD]

# Demo Request
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/demo_request[\s&] [NC]
RewriteRule ^index\.php$ /organise-a-product-demonstration/? [R=301,L,QSD]

# Trial Request
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/trial_request[\s&] [NC]
RewriteRule ^index\.php$ /organise-a-product-trial/? [R=301,L,QSD]

# Funding Support
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/funding_support[\s&] [NC]
RewriteRule ^index\.php$ /funding-support/? [R=301,L,QSD]

# Place Order
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/place_order[\s&] [NC]
RewriteRule ^index\.php$ /place-an-order/? [R=301,L,QSD]

# Warranty Claim
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/warranty_claim[\s&] [NC]
RewriteRule ^index\.php$ /warranty-claim/? [R=301,L,QSD]

# Contact
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/contact[\s&] [NC]
RewriteRule ^index\.php$ /contact-mobilitycare/? [R=301,L,QSD]

# Product Enquiry
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/product_enq[\s&] [NC]
RewriteRule ^index\.php$ /product_enq/? [R=301,L,QSD]

# Light Drive Enquiry
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/lightDriveEnquiry[\s&] [NC]
RewriteRule ^index\.php$ /light-drive-2-enquiry/? [R=301,L,QSD]

# Autochair Enquiry
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/autochairEnquiry[\s&] [NC]
RewriteRule ^index\.php$ /autochair-smart-lifter-enquiry/? [R=301,L,QSD]

# Find Dealer Form
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/find_dealer_form[\s&] [NC]
RewriteRule ^index\.php$ /request-local-dealer/? [R=301,L,QSD]

# Become a Dealer
RewriteCond %{THE_REQUEST} \s/index\.php\?route=dealer/dealer[\s&] [NC]
RewriteRule ^index\.php$ /become-a-dealer/? [R=301,L,QSD]

