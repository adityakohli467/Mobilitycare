# Canonical redirect (THIS LINE FIXES YOUR ISSUE)
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/form_success/trial_request[\s&] [NC]
RewriteRule ^index\.php$ /thank-you-trial_request [R=301,L,QSD]

# warranty claim form success

RewriteRule ^thank-you-warranty-claim/?$ index.php?route=information/form_success/warranty_claim [L,QSA]

# Canonical redirect
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/form_success/warranty_claim[\s&] [NC]
RewriteRule ^index\.php$ /thank-you-warranty-claim [R=301,L,QSD]

# become a dealer form success

RewriteRule ^thank-you-becomedealer/?$ index.php?route=information/form_success/becomedealer [L,QSA]

# Canonical redirect
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/form_success/becomedealer[\s&] [NC]
RewriteRule ^index\.php$ /thank-you-becomedealer [R=301,L,QSD]

# account registration

RewriteRule ^register/?$ index.php?route=account/register [L,QSA]

# Canonical redirect
RewriteCond %{THE_REQUEST} \s/index\.php\?route=account/register[\s&] [NC]
RewriteRule ^index\.php$ /register [R=301,L,QSD]




# account registration success

RewriteRule ^thank-you-account/?$ index.php?route=account/success [L,QSA]

# Canonical redirect
RewriteCond %{THE_REQUEST} \s/index\.php\?route=account/success[\s&] [NC]
RewriteRule ^index\.php$ /thank-you-account [R=301,L,QSD]



# account login

RewriteRule ^login/?$ index.php?route=account/login [L,QSA]

# Canonical redirect
RewriteCond %{THE_REQUEST} \s/index\.php\?route=account/login[\s&] [NC]
RewriteRule ^index\.php$ /login [R=301,L,QSD]


# forgot password

RewriteRule ^forgotpassword/?$ index.php?route=account/forgotten [L,QSA]

# Canonical redirect
RewriteCond %{THE_REQUEST} \s/index\.php\?route=account/forgotten[\s&] [NC]
RewriteRule ^index\.php$ /forgotpassword [R=301,L,QSD]



############################################################
# SEO URL Rewrite (Default OpenCart rule)
############################################################
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?_route_=$1 [L,QSA]

############################################################
# Redirect direct index.php GET requests to clean root URL
############################################################
RewriteCond %{THE_REQUEST} \s/+index\.php [NC]
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^index\.php$ / [R=301,L]

############################################################
# Disable directory browsing
############################################################
Options -Indexes

############################################################
# GZIP Compression
############################################################
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2
  # Ensure proper Vary header for compressed content
  Header append Vary Accept-Encoding
</IfModule>

############################################################
# Browser Caching
############################################################
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Cache static assets
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|otf|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Don't cache HTML
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Keep-Alive
  Header set Connection keep-alive
  # Vary header for WebP content negotiation (image model serves WebP based on Accept)
  <FilesMatch "\.(jpg|jpeg|png)$">
    Header append Vary Accept
  </FilesMatch>
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php81" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
