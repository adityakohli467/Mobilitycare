RewriteRule ^.*$ /shop/electric-toilet? [R=301,L]

RewriteCond %{REQUEST_URI} ^/buy/topro-olympos-offroad-rollator/?$ [NC]
RewriteRule ^.*$ /buy/topro-olympos-all-terrain-offroader-rollator? [R=301,L]


# Topro Olympos Offroad Rollator → All Terrain Offroader
RewriteCond %{REQUEST_URI} ^/buy/topro-olympos-offroad-rollator/?$ [NC]
RewriteRule ^.*$ /buy/topro-olympos-all-terrain-offroader-rollator? [R=301,L]

# Topro Troja Forearm Gutter Frame Walker → New URL
RewriteCond %{REQUEST_URI} ^/buy/topro-troja-forearm-gutter-frame-walker/?$ [NC]
RewriteRule ^.*$ /buy/topro-troja-frame-walker? [R=301,L]

# OnTrac Solid Ramp → PVI OnTrac Solid Ramp
RewriteCond %{REQUEST_URI} ^/buy/ontrac-solid-ramp/?$ [NC]
RewriteRule ^.*$ /buy/pvi-ontrac-solid-ramp? [R=301,L]

