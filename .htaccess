RewriteCond %{REQUEST_URI} ^/buy/al1-panorama-linearlift/?$ [NC]
RewriteRule ^.*$ /buy/amf-bruns-al1-panorama-linearlift? [R=301,L]

# Light Assist → Light Assist Wheelchair Power Assist
RewriteCond %{REQUEST_URI} ^/buy/light-assist/?$ [NC]
RewriteRule ^.*$ /buy/light-assist-wheelchair-power-assist? [R=301,L]
 

# Redirect old Topro manufacturer URL (ID=12) → new SEO URL




RewriteCond %{QUERY_STRING} ^route=product/manufacturer/info(&|&amp;)manufacturer_id=8$ [NC]
RewriteRule ^index\.php$ /shop/mangar-lifting-cushion? [R=301,L]

RewriteCond %{QUERY_STRING} ^route=product/manufacturer/info(&|&amp;)manufacturer_id=11$ [NC]
RewriteRule ^index\.php$ /shop/autochair-scooter-hoist? [R=301,L]

