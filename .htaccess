RewriteRule ^index\.php$ /ndis/? [R=301,L,QSD]

# Support / Customer Service
RewriteCond %{THE_REQUEST} \s/index\.php\?route=information/support[\s&] [NC]
RewriteRule ^index\.php$ /customer-service/? [R=301,L,QSD]

RewriteRule ^sitemap\.xml$ index.php?route=extension/feed/google_sitemap [L,QSA]

# 404 fix: /mangar-lifting-cushion → correct manufacturer URL
RewriteRule ^mangar-lifting-cushion/?$ /shop/mangar-lifting-cushion [R=301,L]

# Redirect old topro product tag URLs
