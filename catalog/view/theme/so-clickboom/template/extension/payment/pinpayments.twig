<div class="card" id="payment">
    {% if error_warning %}
        <div class="alert alert-danger hidden">{{ error_warning }}</div>
    {% endif %}
    <div class="card-body">
        <h4>{{ heading_title }}</h4>
        
        <!-- Card Number with Icon -->
        <div class="form-group">
            <label for="card_number">{{ text_card_number }}</label>
            <div class="input-group">
                <span class="input-group-addon">
                    <i class="fa fa-credit-card text-success" style="color: #28a745;"></i>
                </span>
                <input type="text" name="card_number" value="" placeholder="1234 5678 9012 3456" class="form-control" />
            </div>
        </div>
        
        <!-- Expiry & CVC with Icons -->
        <div class="form-group">
            <label>{{ text_expiry_month }} / {{ text_expiry_year }} &nbsp;&nbsp; {{ text_cvc }}</label>
            <div class="row" style="margin-left: 0; margin-right: 0;">
                <div class="col-xs-4" style="padding: 0 2px 0 0;">
                    <div class="input-group" style="width: 100%;">
                        <span class="input-group-addon">
                            <i class="fa fa-calendar text-warning" style="color: #ffc107;"></i>
                        </span>
                        <input type="text" name="expiry_month" value="" placeholder="MM" class="form-control" />
                    </div>
                </div>
                <div class="col-xs-4" style="padding: 0 2px;">
                    <div class="input-group" style="width: 100%;">
                        <span class="input-group-addon">
                            <i class="fa fa-calendar text-warning" style="color: #ffc107;"></i>
                        </span>
                        <input type="text" name="expiry_year" value="" placeholder="YY" class="form-control" />
                    </div>
                </div>
                <div class="col-xs-4" style="padding: 0 0 0 2px;">
                    <div class="input-group" style="width: 100%;">
                        <span class="input-group-addon">
                            <i class="fa fa-lock" style="color: #dc3545;"></i> <!-- Replaced fa-lock with fa-key -->
                        </span>
                        <input type="text" name="cvc" value="" placeholder="CVC" class="form-control" />
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Confirm Button with Icon -->
        <button type="button" id="button-confirm" class="btn btn-primary btn-block">
            <i class="fa fa-check-circle text-white" style="margin-right: 5px;"></i> Place order
        </button>
    </div>
</div>


<style>
/* Scoped to #payment-ui-container to avoid colliding with Bootstrap/header styles */
#payment-ui-container .input-group {
    width: 100%;
    display: flex;
    align-items: stretch;
}

#payment-ui-container .input-group-addon {
    padding: 6px 12px;
    background-color: #fff;
    border: 1px solid #ccc;
    border-right: none;
    width: 40px;
    text-align: center;
}

#payment-ui-container .input-group .form-control {
    border-left: none;
    border-radius: 0 4px 4px 0;
    flex: 1;
}

#payment-ui-container .row {
    margin-left: 0;
    margin-right: 0;
}

#payment-ui-container .col-xs-4 {
    padding: 0 2px;
}

#payment-ui-container .col-xs-4:last-child .input-group {
    width: 100%;
}
</style>