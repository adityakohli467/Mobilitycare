<footer class="footer-container wow  fadeInUp typefooter-{{typefooter ? typefooter : '1'}}">
	{#======	FOOTER TOP	=======#}  
	{% if footer_block5 is not empty %}
	<div class="footer-main collapse description-has-toggle" id="collapse-footer">
	
		{{footer_block5}}
			
	</div>
	<div class="description-toggle hidden-lg hidden-md hidden">
         <a class="showmore" data-toggle="collapse" href="#collapse-footer" aria-expanded="false" aria-controls="collapse-footer">
            <span class="toggle-more">{{ objlang.get('show_more') }} <i class="fa fa-angle-down"></i></span> 
            <span class="toggle-less">{{ objlang.get('show_less') }} <i class="fa fa-angle-up"></i></span>           
		</a>        
	</div>
	{% endif %}
	
	
	{#======	FOOTER BOTTOM	=======#} 
	<div class="footer-bottom">
		<div class="container">
			<div class="row">				
				<div class="copyright col-lg-7 col-md-8 col-sm-12 col-xs-12">
					{% if soconfig.get_settings('copyright') is empty %}
						{{ powered }}
					{% else %}
						{{ soconfig.get_settings('copyright')|replace({'{year}': "now"|date("Y")}) }}
					{% endif %}
				</div>
				{% if soconfig.get_settings('imgpayment_status')%} 
				<div class="footer-payment col-lg-5 col-md-4 col-sm-12 col-xs-12">
					<img class="lazyload" data-sizes="auto" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="image/{{  soconfig.get_settings('imgpayment') }}"  alt="Payment methods" width="400" height="40" loading="lazy">
				</div>
				{% endif %}
			</div>
		</div>
	</div>
</footer>