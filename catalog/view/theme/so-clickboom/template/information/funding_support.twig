{{ header }}
  <link href="catalog/view/theme/so-clickboom/css/customerForms.css" rel="stylesheet" type="text/css" />

  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
    <div class="container text-black">
    <div class="row mt-5">
        <div class="demo-request-container">
    <div class="demo-request-left col-md-5 col-sm-12">
        <h1>Check your eligibility</h1>
        <p>Mobility aids can be quite expensive for many of us to afford.  </p>
        <p>
            

Thankfully, nearly all products we sell are subsidised by the Government through state funding agencies and organisations such as NDIS, DVA, VMSS, EnableNSW, ILC and MASS. 

This means that you can purchase a piece of equipment from us at a much more affordable price. 

To see if you're eligible to receive Government funding for the mobility aids you require, simply fill out the form  and we'll get back to you as soon as possible. 
        </p>
        <div class="profile">
            
            <p><strong>Submit your request </strong></p>
        </div>
    </div>
    
    <div class="demo-request-right col-md-7 col-sm-12">
        <!-- HubSpot Form: Checking your eligibility -->
        <div id="hubspotForm-funding-support" class="hubspot-form-embed"></div>
        <script charset="utf-8" type="text/javascript" src="//js.hsforms.net/forms/embed/v2.js"></script>
        <script>
          hbspt.forms.create({
            region: "ap1",
            portalId: "443388967",
            formId: "5af5bde5-22ec-45a8-ac0e-b602f1047d6c",
            target: "#hubspotForm-funding-support"
          });
        </script>
        <div id="toastMessage" class="toast"></div>
        <div id="loaderOverlay" class="loader-overlay">
        <div class="loader"></div>
         </div>
    </div>
</div>


    </div> 
    </div>
    </div> 
    {{ column_right }}
    </div> 
