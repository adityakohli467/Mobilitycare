<style>
/* ===== Landscape Mode Fixes ===== */
@media screen and (orientation: landscape) {
	/* Override Ratchet's fixed body — allow natural document flow in landscape */
	body {
		position: relative !important;
		height: auto !important;
		min-height: 100vh;
	}

	/* Override Ratchet's absolute content — use normal flow */
	.content {
		position: relative !important;
		top: auto !important;
		right: auto !important;
		bottom: auto !important;
		left: auto !important;
		min-height: calc(100vh - 84px);
		overflow-y: visible !important;
	}

	/* Keep header fixed at top in landscape */
	.bar.bar-nav {
		position: fixed !important;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		height: 44px !important;
		min-height: 44px !important;
		padding: 2px 0 !important;
	}

	/* Push content below fixed header */
	.content {
		margin-top: 44px !important;
		padding-bottom: 44px !important;
	}

	/* Keep bottom bar fixed */
	.bar.bar-tab {
		position: fixed !important;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		height: 40px !important;
		min-height: 40px !important;
	}
	.bar.bar-tab .tab-item {
		padding: 2px 0 !important;
	}
	.bar.bar-tab .tab-item .icon,
	.bar.bar-tab .tab-item .icon i {
		font-size: 16px !important;
		height: 18px !important;
		line-height: 18px !important;
	}
	.bar.bar-tab .tab-label {
		font-size: 9px !important;
	}

	/* Shrink logos in landscape */
	.mobile-logo-wrapper img,
	.mobile-logo-wrapper a img {
		height: 20px !important;
		width: auto !important;
	}
	.mobile-logo-wrapper {
		gap: 6px !important;
	}

	/* Compact hamburger menu */
	.navbar-menu {
		padding-top: 2px !important;
	}

	/* Compact phone link */
	.navbar-phone-link {
		font-size: 11px !important;
	}

	/* Breadcrumb: full width, no clipping */
	.breadcrumb {
		white-space: nowrap;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	/* Product page: use full landscape width */
	.content-main.product-detail {
		padding-left: 15px !important;
		padding-right: 15px !important;
	}

	/* Product image: reasonable size in landscape */
	.content-product-left img {
		max-height: 50vh;
		width: auto;
		margin: 0 auto;
		display: block;
	}

	/* Horizontal overflow prevention */
	.content, .content-main, .container, .container-fluid, .row {
		max-width: 100vw;
		overflow-x: hidden;
	}
}

/* ===== General Mobile Fixes ===== */
/* Prevent horizontal shift/scroll on all orientations */
.content-main, .container, .row {
	max-width: 100vw;
	overflow-x: hidden;
}

/* Back-to-top above bottom tab bar */
.back-to-top {
	bottom: 80px !important;
	right: 15px !important;
}
@media screen and (orientation: landscape) {
	.back-to-top {
		bottom: 55px !important;
		right: 10px !important;
		padding: 8px 10px !important;
		font-size: 12px !important;
	}
}
</style>
