<!-- Google Maps API: load only when #map element exists on page -->
<script>
function loadGoogleMaps(){
  if(window._mapsLoading)return;window._mapsLoading=true;
  var s=document.createElement('script');
  s.src='https://maps.googleapis.com/maps/api/js?key=AIzaSyBYD_DZ8jWG9LqYaiKxr-3VAiN_JPkVzCk&libraries=places&callback=initMap';
  s.async=true;s.defer=true;document.head.appendChild(s);
}
</script>
