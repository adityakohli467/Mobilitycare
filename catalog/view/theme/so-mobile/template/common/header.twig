{{soconfig.addJs('catalog/view/theme/'~theme_directory~'/js/so.custom.js')}}
{{soconfig.addJs('catalog/view/theme/'~theme_directory~'/js/common.js')}}
{% for script in scripts %} {{soconfig.addJs(script)}} {% endfor %}
{% if class[:12] == 'information-' or class[:9] == 'checkout-' %}
{{soconfig.addJs('catalog/view/javascript/formValidate.js')}}
{% endif %}


{# =========== Begin Other CSS & JS  ==============#}
{{soconfig.scss_compassMobile}}
{{soconfig.css_out(soconfig.get_settings('cssExclude'))}}
{{soconfig.js_out(soconfig.get_settings('jsExclude'))}}


{# =========== Begin Google Font ==============#}
{% if soconfig.get_settings('murl_body')  and  soconfig.get_settings('mbody_status') ==  'google' %} <link href='{{ soconfig.get_settings('murl_body') }}&display=swap' rel='stylesheet' media="print" onload="this.media='all'"> {% endif %} 	
