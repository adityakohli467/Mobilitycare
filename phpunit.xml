<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="upload/system/storage/vendor/autoload.php"
         colors="true"
         verbose="true">

    <testsuites>
        <testsuite name="MobilityCare Core Web Vitals Fixes">
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory suffix=".php">catalog/controller/product</directory>
        </include>
    </coverage>

</phpunit>
